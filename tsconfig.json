{
  "include": [
    "client/src/main.tsx",
    "client/src/App.tsx",
    "client/src/index.css",
    "client/src/pages/Home.tsx",
    "client/src/components/JobComposer.tsx",
    "client/src/lib/supabase.ts",
    "client/src/lib/subtitles.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["vite/client"]
  }
}
